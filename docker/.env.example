# Chakram Node Configuration
# Copy this file to .env and edit before running 'chakramctl up'

# Node mode: dev | localnet | fullnode
CHAKRAM_MODE=dev

# Chain and network identifiers
CHAKRAM_CHAIN_ID=chakram-testnet-1
CHAKRAM_NETWORK_ID=11640

# EVM address that receives block rewards (validator reward address)
# Leave blank to auto-generate a fresh key on first 'chakramctl init dev'
# (the address and private key will be written to secrets/evm-key-dev.json)
CHAKRAM_REWARD_ADDRESS=

# Log level: debug | info | warn | error
CHAKRAM_LOG_LEVEL=info

# Path to JWT secret file (created automatically if not present)
# Must match between geth and chakram containers
CHAKRAM_JWT_FILE=./secrets/jwt.hex

# Faucet address (dev mode only) — must be funded in genesis
CHAKRAM_FAUCET_ADDR=
CHAKRAM_FAUCET_KEY=

# Publicly reachable IP or hostname for P2P connections (auto-detected by setup.sh)
# Used in /api/node-info to give fullnode operators the correct peer string and enode
CHAKRAM_P2P_HOST=

# Fullnode mode: comma-separated CometBFT persistent peers
# Format: <node-id>@<host>:<port>
CHAKRAM_PEERS=

# Fullnode mode: geth bootnode enode URL(s) for peer discovery
CHAKRAM_GETH_BOOTNODES=

# Localnet mode: per-node reward addresses
# Leave blank to auto-generate fresh keys on 'chakramctl init localnet'
# (keys written to secrets/evm-key-node{0..3}.json)
CHAKRAM_NODE0_REWARD=
CHAKRAM_NODE1_REWARD=
CHAKRAM_NODE2_REWARD=
CHAKRAM_NODE3_REWARD=

# Phase 3 staking — StakingRegistry.sol contract address
# Leave empty to run in PoA mode (genesis-defined validator set, no staking)
# Set after deploying: python3 contracts/deploy.py
CHAKRAM_STAKING_CONTRACT=

# Monitoring — run setup.sh to auto-generate a secure random password
# Never set this to "chakram" or leave it empty
GRAFANA_ADMIN_PASSWORD=
